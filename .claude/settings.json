{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.vercel/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel env pull*)"
    ]
  }
}
