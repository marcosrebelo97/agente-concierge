{
  "name": "agente-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "Agente concierge de hospedagem: tira dúvidas só com o catálogo, cota pela regra de preço, registra o lead depois da confirmação e passa para um humano quando deve.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.7",
    "@upstash/redis": "^1.41.0",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  }
}
