# Chave da API da Anthropic
ANTHROPIC_API_KEY=

# Token pessoal do teste: catálogo e webhook de leads usam o mesmo
SEAZONE_TOKEN=

# Sessões. Sem estas duas variáveis (ou KV_REST_API_URL/_TOKEN, os nomes que a Vercel injeta), as sessões
# ficam em memória: funcionam num único processo, como no Docker, mas se perdem a cada reinício
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcionais
# Modelo: claude-haiku-5-5 é uma alternativa mais barata, com resultado equivalente (docs/EVALS.md)
# MODELO=claude-sonnet-5-5
# Esforço do modelo: low, medium ou high
# ESFORCO=medium
# Servidor Node (no Docker, a imagem e o compose já usam HOST=0.0.0.0)
# HOST=127.0.0.1
# PORT=3000
