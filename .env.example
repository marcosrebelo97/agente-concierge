# Chave da API da Anthropic
ANTHROPIC_API_KEY=

# Token pessoal do teste: catálogo e webhook de leads usam o mesmo
SEAZONE_TOKEN=

# Sessões. Sem estas duas variáveis, as sessões ficam em memória (só para desenvolvimento local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcionais
# Modelo: claude-haiku-5-5 também passou em todos os evals (docs/EVALS.md)
# MODELO=claude-sonnet-5-5
# Esforço do modelo: low, medium ou high
# ESFORCO=medium
# Servidor Node: use HOST=0.0.0.0 em contêiner
# HOST=127.0.0.1
# PORT=3000
